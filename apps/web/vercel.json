{
  "rewrites": [
    {
      "source": "/v1/:path*",
      "destination": "https://api.chronicler.smokebombstudios.com/v1/:path*"
    },
    {
      "source": "/auth/discord",
      "destination": "https://api.chronicler.smokebombstudios.com/auth/discord"
    },
    {
      "source": "/auth/discord/:path*",
      "destination": "https://api.chronicler.smokebombstudios.com/auth/discord/:path*"
    },
    {
      "source": "/health",
      "destination": "https://api.chronicler.smokebombstudios.com/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
