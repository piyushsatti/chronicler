{
  "installCommand": "cd ../.. && bun install --frozen-lockfile",
  "buildCommand": "cd ../.. && bun run --filter @pi/contracts build && bun run --filter @pi/web build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/v1/:path*",
      "destination": "https://chronicler-api.piyushsatti.com/v1/:path*"
    },
    {
      "source": "/auth/discord",
      "destination": "https://chronicler-api.piyushsatti.com/auth/discord"
    },
    {
      "source": "/auth/discord/:path*",
      "destination": "https://chronicler-api.piyushsatti.com/auth/discord/:path*"
    },
    {
      "source": "/health",
      "destination": "https://chronicler-api.piyushsatti.com/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
