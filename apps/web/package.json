{
  "name": "@pi/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests && node ../../scripts/design-gates/run-all.mjs",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:e2e": "playwright test --config playwright.config.ts",
    "codegen:graphql": "graphql-codegen --config codegen.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@js-temporal/polyfill": "0.5.1",
    "@pi/contracts": "workspace:*",
    "@pi/react-imposition": "github:piyushsatti/imposition#v0.1.0",
    "@reduxjs/toolkit": "^2.12.0",
    "@tanstack/react-query": "^5.60.0",
    "dompurify": "3.4.10",
    "mermaid": "11.15.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "10.1.0",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.0.0",
    "remark-gfm": "4.0.1",
    "unist-util-visit": "5.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@graphql-codegen/cli": "^7.0.0",
    "@graphql-codegen/typescript": "^6.0.1",
    "@graphql-codegen/typescript-operations": "^6.0.1",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/mdast": "4.0.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^9.0.0",
    "jsdom": "^25.0.0",
    "msw": "^2.6.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "vitest": "^2.0.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}