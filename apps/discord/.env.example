# Copy to apps/discord/.env.local. config.ts loads that file outside tests.
# Docker injects the same names and ignores a missing file.

# Required. Heartbeat is on unless BOT_HEARTBEAT_ENABLED=false, and then
# GUILD_ID and INGEST_SECRET are required too.
BOT_DISCORD_TOKEN=
GUILD_ID=
INGEST_SECRET=dev-ingest-secret

# Origin only, no path. Must equal BOT_API_ALLOWED_ORIGIN.
# http is refused unless BOT_ALLOW_INSECURE_API_URL=true.
API_URL=http://127.0.0.1:8080
BOT_API_ALLOWED_ORIGIN=http://127.0.0.1:8080
BOT_ALLOW_INSECURE_API_URL=true

SNIFFER_ENABLED=false
BOT_HEARTBEAT_ENABLED=true

# Mentions stay off. When AGENT_ENABLED=true, set AGENT_ALLOWED_DM_USER_IDS
# or both AGENT_ALLOWED_GUILD_IDS and AGENT_ALLOWED_CHANNEL_IDS (snowflakes).
# AGENT_PUBLIC_ORIGIN is required (HTTPS origin) when the agent is on.
AGENT_ENABLED=false
AGENT_ALLOWED_GUILD_IDS=
AGENT_ALLOWED_CHANNEL_IDS=
AGENT_ALLOWED_DM_USER_IDS=
AGENT_PUBLIC_ORIGIN=
AGENT_MAX_CONCURRENT=2
AGENT_QUEUE_CAPACITY=25

# Optional labels on the heartbeat body.
BOT_HOST=
BOT_BUILD_ID=
