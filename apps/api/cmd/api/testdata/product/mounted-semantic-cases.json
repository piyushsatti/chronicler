        {
          "action": "Claim053/031 as owning player002; capture attributed progression UUID",
          "expected": {
            "totalPcxpAwarded": 4,
            "coverage": "COMPLETE"
          }
        },
        {
          "action": "Replay identical claim",
          "expected": {
            "totalPcxpAwarded": 4,
            "coverage": "COMPLETE"
          }
        }
      ],
      "set_boundary": {
        "selected_quests": [
          "10000000-0000-4000-8000-000000000051",
          "10000000-0000-4000-8000-000000000055"
        ],
        "expected": {
          "totalPcxpAwarded": null,
          "coverage": "LEGACY_UNKNOWN"
