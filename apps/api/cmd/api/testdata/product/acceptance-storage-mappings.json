  "rules": [
    "Only fixture/effect boundaries apply these aliases; GraphQL response fields remain wire values.",
    "Public UUID FK references resolve once to actual owning bigint IDs, never insert UUID into bigint column.",
    "Physical fixture.rows, update.set and physical_projection.columns prohibit logical column aliases.",
    "Document JSON frontmatter uses typed JSON\u2194YAML codec, preserving json.Number lexical values.",
    "JSON fact snapshots are stored in actual payload/old_value/new_value; their keys are not added SQL columns.",
    "Legacy before0003 fixtures use baseline inventory; final fixtures use proposed0003 inventory, then actual native schema introspection.",
    "Metadata keys specify assertion operators/counts, never literal INSERT columns."
  ]
}
