{"table":"documents","conflict":["public_id"],"refs":{"author_id":{"table":"members","public_id":"00000001-0000-4000-8000-000000000004"}},"row":{"body":"Cox calls marching order before the first hex. Changing it mid-hex is a new decision and costs the time of a decision.","category":"table","deleted_by":null,"kind":"rule","public_id":"00000002-0000-4000-8000-000000000068","published_at":"2026-09-14T18:00:00Z","published_by":null,"slug":"marching-order","status":"published","title":"Marching Order","version":0,"visibility":"public"}}
{"table":"documents","conflict":["public_id"],"refs":{"author_id":{"table":"members","public_id":"00000001-0000-4000-8000-000000000005"}},"row":{"body":"Posted in the quest brief. Adding one mid-session is allowed. Arguing someone out of one is not.","category":"table","deleted_by":null,"kind":"rule","public_id":"00000002-0000-4000-8000-000000000069","published_at":"2026-09-14T18:00:00Z","published_by":null,"slug":"lines-and-veils","status":"published","title":"Lines and Veils","version":0,"visibility":"public"}}
{"table":"documents","conflict":["public_id"],"refs":{"author_id":{"table":"members","public_id":"00000001-0000-4000-8000-000000000006"}},"row":{"body":"Pell's table writes bargains down. A bargain that is only spoken can be forgotten on purpose, and that is the point of writing.","category":"table","deleted_by":null,"kind":"rule","public_id":"00000002-0000-4000-8000-00000000006a","published_at":"2026-09-14T18:00:00Z","published_by":null,"slug":"written-bargains","status":"published","title":"Written Bargains","version":0,"visibility":"public"}}
