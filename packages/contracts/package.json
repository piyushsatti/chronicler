{
  "name": "@pi/contracts",
  "version": "0.1.0",
  "description": "Shared GraphQL schema, generated TypeScript types, and region config for Chronicler clients.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "schema.graphql",
    "regions.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema.graphql": "./schema.graphql",
    "./regions.json": "./regions.json"
  },
  "scripts": {
    "codegen": "graphql-codegen --config codegen.ts",
    "build": "bun run codegen && tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "prepack": "bun run build"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.0.0",
    "@graphql-codegen/typescript": "^6.0.1",
    "graphql": "^16.9.0",
    "typescript": "^5.6.0"
  }
}
