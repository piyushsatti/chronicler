{
  "schema_version": 1,
  "definition": "D3/D20 with July 30 long-form seam: closed audience markers and shared finite handle charset; outer gate precedes blocks",
  "scope": "shared parser/projection vectors; editor runtime must consume these before claiming two-runtime conformance",
  "body_policy_ruling": {
    "owner_date": "2026-10-11",
    "decision": "Enforce per-viewer blocks everywhere (Recommended)",
    "applies_to": "Every readable document, including SQL NULL and JSON-null policy",
    "preserves": "Whole-document access, author raw bypass and audited administrator raw bypass",
    "legacy_tier": "DM/archon outer grants do not bypass member or literal-role block scopes"
  },
  "viewer_examples": {
    "dm": {
      "member_id": "viewer",
      "roles": ["dm"],
      "handle": "Other"
    },
    "member": {
      "member_id": "viewer",
      "roles": ["player"],
      "handle": "Exact-Handle"
    }
  },
  "preserved_source_behavior": [
    "Maximal consecutive blockquote run is one span; nested marker scopes entire run",
    "Bare marker scopes its own line, including code-fence text",
    "Malformed outranks handle, then DM, then spoiler; first of multiple valid handle markers is retained",
    "Ordinary unknown callouts remain visible; spoiler is presentation only",
    "A closing bracket terminates the marker token; it cannot encode a longer member identity containing that delimiter"
  ],
  "open_conformance_gaps": [
    "Database handles outside [A-Za-z0-9_.-]+ cannot be written as accepted markers; their document-policy member principals remain valid",
    "No owner ruling independently names multi-handle precedence; first valid handle preserves the examined source",
    "Frontend save-time validation/editor conformance remains a later independently verified consumer"
  ],
