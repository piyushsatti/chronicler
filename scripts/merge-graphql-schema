#!/usr/bin/env bash
set -euo pipefail
root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$root"
exec bun run --no-env-file - "$root" <<'JS'
import fs from 'node:fs';
import path from 'node:path';
import { buildASTSchema, parse, validateSchema } from 'graphql';

const root = process.argv[2];
const source = path.join(root, 'packages/contracts/graphql');
const output = path.join(root, 'packages/contracts/schema.graphql');
const paths = [];
function discover(dir) {
  for (const entry of fs.readdirSync(dir, { withFileTypes: true })) {
    const filename = path.join(dir, entry.name);
    if (entry.isSymbolicLink()) throw new Error(`SDL discovery refuses symlink ${filename}`);
    if (entry.isDirectory()) discover(filename);
    else if (entry.isFile() && entry.name.endsWith('.graphql')) paths.push(filename);
  }
}
discover(source);
paths.sort();
if (!paths.length) throw new Error('No GraphQL SDL sources discovered');
const body = paths.map((filename) => {
  const name = path.relative(source, filename).split(path.sep).join('/');
  const input = fs.readFileSync(filename, 'utf8');
  parse(input);
  return `# --- ${name} ---\n${input.trimEnd()}\n`;
}).join('\n');
const schema = buildASTSchema(parse(body));
const errors = validateSchema(schema);
if (errors.length) throw new Error(errors.map((error) => error.message).join('\n'));
const merged = '# Generated by scripts/merge-graphql-schema. Do not edit by hand.\n# Sources: packages/contracts/graphql/ (recursive, sorted)\n\n' + body;
const temporary = `${output}.${process.pid}.tmp`;
try {
  fs.writeFileSync(temporary, merged, { flag: 'wx' });
  fs.renameSync(temporary, output);
} finally {
  if (fs.existsSync(temporary)) fs.unlinkSync(temporary);
}
console.log(`wrote ${output} from ${paths.length} validated SDL sources`);
JS
