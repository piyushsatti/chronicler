#!/usr/bin/env bash
# Merge packages/contracts/graphql/*.graphql into schema.graphql for web codegen.
set -euo pipefail
root="$(cd "$(dirname "$0")/.." && pwd)"
src="$root/packages/contracts/graphql"
out="$root/packages/contracts/schema.graphql"
{
  echo "# Generated by scripts/merge-graphql-schema. Do not edit by hand."
  echo "# Sources: packages/contracts/graphql/"
  echo
  for f in scalars roots site member document spatial character quest; do
    path="$src/$f.graphql"
    if [[ -f "$path" ]]; then
      echo "# --- $f.graphql ---"
      cat "$path"
      echo
    fi
  done
} > "$out"
echo "wrote $out"
