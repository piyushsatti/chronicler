#!/usr/bin/env bash
# Repo tooling gate. Does not typecheck or test apps/web or apps/agent.
# Full gate: scripts/verify. Agent CI: .github/workflows/agent.yml.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

python3 scripts/docs-lint.py
python3 scripts/ci_runner_test.py

bunx prettier --check \
  prettier.config.js \
  eslint.config.js \
  package.json \
  CHANGELOG.md \
  README.md \
  CONTRIBUTING.md \
  AGENTS.md \
  scripts \
  .github

uv run ruff check scripts
uv run ruff format --check scripts
uv run pyright

bunx eslint scripts prettier.config.js eslint.config.js

echo "verify-repo: ok"
