# Release stack variables for deploy/compose.production.yaml.
# Copy to deploy/.env (never commit it) and fill in. Values here are empty on purpose.
# The deploy workflows write these to an env file on the runner host and set
# COMPOSE_PROFILES; set it yourself only for a local rehearsal.
#   COMPOSE_PROFILES=local-db   run the Compose PostgreSQL (staging)
#   COMPOSE_PROFILES=tunnel     run the Cloudflare Tunnel connector (production)

# --- Database: pick one ---
# Hosted PostgreSQL (production): Supabase session pooler URI, e.g.
# postgresql://postgres.<ref>:<password>@<pooler-host>:5432/postgres?sslmode=require
# Optional &pool_max_conns=N caps the API pool (default: the greater of 4 and the CPU count).
# When set, the API uses it and builds no local URL from the POSTGRES_* values below.
DATABASE_URL=
# Compose PostgreSQL (profile local-db): used only while DATABASE_URL is unset.
# Database superuser name created on first volume init
POSTGRES_USER=
# Database password; use URL-safe characters (it is embedded in the local DATABASE_URL)
POSTGRES_PASSWORD=
# Database name
POSTGRES_DB=

# --- Images ---
# API image, e.g. ghcr.io/piyushsatti/chronicler/api:<sha>; unset to build locally with --build
API_IMAGE=
# Discord bot image, e.g. ghcr.io/piyushsatti/chronicler/discord:<sha>; unset to build locally
DISCORD_IMAGE=

# --- API ---
# Host loopback port for the API (default 8080)
API_PORT=
# Secret used to sign session JWTs (required)
JWT_SECRET=
# Shared secret between the bot and the API ingest endpoints (required)
INGEST_SECRET=
# Discord OAuth application client id
DISCORD_CLIENT_ID=
# Discord OAuth application client secret
DISCORD_CLIENT_SECRET=
# OAuth redirect URI: the web callback page, https://<web domain>/auth/callback
DISCORD_REDIRECT_URI=
# Comma-separated browser origins allowed by CORS
CORS_ORIGINS=
# Platform owner member id (optional)
PLATFORM_OWNER_MEMBER_ID=
# Platform owner Discord user id (optional)
PLATFORM_OWNER_DISCORD_ID=
# Graceful shutdown timeout, Go duration such as 10s or milliseconds (optional)
SHUTDOWN_TIMEOUT=
# Worker: bot token for Discord REST quest announcements
DISCORD_BOT_TOKEN=
# Worker: channel id that receives quest announcements
DISCORD_ANNOUNCE_CHANNEL_ID=

# --- Discord bot (gateway sensor) ---
# Gateway bot token (required)
BOT_DISCORD_TOKEN=
# Discord application client id of the bot (required)
BOT_CLIENT_ID=
# Guild (server) id the bot serves (required)
GUILD_ID=
# true/false: forward message observations (optional; Actions: vars.SNIFFER_ENABLED)
SNIFFER_ENABLED=
# true/false: send heartbeats to the API, on unless false (optional; Actions: vars.BOT_HEARTBEAT_ENABLED)
BOT_HEARTBEAT_ENABLED=

# --- Cloudflare Tunnel (production, profile tunnel) ---
# Token of the remotely managed tunnel; the connector reads it as TUNNEL_TOKEN (required with the tunnel profile)
CLOUDFLARE_TUNNEL_TOKEN=
