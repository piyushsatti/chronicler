{
  "name": "chronicler",
  "license": "GPL-2.0-only",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*",
    "apps/web",
    "apps/discord"
  ],
  "scripts": {
    "build:contracts": "bun run --filter @pi/contracts build",
    "codegen": "bun run build:contracts",
    "export-schema": "bash scripts/merge-graphql-schema",
    "check-schema": "bash scripts/merge-graphql-schema && git diff --exit-code -- packages/contracts/schema.graphql",
    "codegen:openapi": "openapi-typescript packages/contracts/openapi.yaml -o apps/web/src/api/openapi.gen.ts",
    "lint": "bun run lint:js && bun run lint:py",
    "lint:js": "eslint .",
    "lint:py": "uv run ruff check . && uv run --directory apps/agent ruff check .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "bun run typecheck:js && bun run typecheck:py",
    "typecheck:js": "bun run --filter @pi/contracts check && bun run --filter @pi/discord typecheck && bun run --filter @pi/web typecheck",
    "typecheck:py": "uv run pyright && uv run --directory apps/agent pyright",
    "test": "bun run --filter @pi/discord test && bun run --filter @pi/web test && bun run test:agent",
    "test:agent": "uv run --directory apps/agent pytest",
    "test:discord": "bun run --filter @pi/discord test",
    "test:web": "bun run --filter @pi/web test",
    "lint:discord": "bun run --filter @pi/discord lint",
    "lint:web": "bun run --filter @pi/web lint",
    "verify": "bash scripts/verify",
    "verify:repo": "bash scripts/verify-repo"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@graphql-codegen/cli": "^7.0.0",
    "@graphql-codegen/typescript": "^6.0.1",
    "eslint": "^9.0.0",
    "graphql": "^16.9.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "openapi-typescript": "^7.8.0"
  },
  "trustedDependencies": [
    "esbuild",
    "sharp"
  ]
}
